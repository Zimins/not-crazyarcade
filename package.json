{
  "name": "not-crazy-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "dev:full": "wrangler dev",
    "build": "pnpm run build:wasm && pnpm run build:sprites && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json && vite build",
    "build:wasm": "wasm-pack build core --target web --out-dir ../src/wasm/pkg --release",
    "build:wasm:dev": "wasm-pack build core --target web --out-dir ../src/wasm/pkg --dev",
    "build:sprites": "node tools/sprites/build.mjs",
    "preview": "vite preview",
    "test:core": "cargo test --manifest-path core/Cargo.toml",
    "deploy": "pnpm build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.20241112.0"
  }
}
