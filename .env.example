# ── Cloudflare Pages Functions 시크릿 (.dev.vars 로 복사해 로컬 개발) ──

# 세션 쿠키 서명 키 (필수, openssl rand -hex 32)
# 미설정 시 인증 API가 동작하지 않음 — 게임은 localStorage 폴백으로 플레이 가능
SESSION_SECRET=

# ── 아래는 v2 OAuth 연동용 예약 (현재 코드에서 미사용) ──────────────
# Google OAuth (https://console.cloud.google.com/apis/credentials)
#   승인된 리디렉션 URI: https://<your-domain>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth App (https://github.com/settings/developers)
#   Authorization callback URL: https://<your-domain>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
